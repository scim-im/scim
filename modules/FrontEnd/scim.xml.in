<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component manifest for SCIM. ibus-daemon reads this from its
     component directory and launches <exec> when a SCIM engine is selected.

     This bootstrap lists only the generic "scim" engine (the default SCIM
     engine). To expose every installed SCIM engine as its own IBus entry,
     regenerate this file from the installed engines:

         scim -f ibus -- --xml > THIS_FILE

     (run it again whenever the set of INSTALLED SCIM engines changes; enabling
     or disabling an engine does not need a regenerate -- the manifest lists all
     installed engines and the active subset is synced with GNOME separately).

     System install: the packager regenerates this file whenever any SCIM
     IMEngine package is installed or removed (e.g. via a dpkg trigger / rpm
     file trigger on the IMEngine module directory), so the system component
     always mirrors the system-wide installed engines. Enumeration runs as root,
     so only system engines appear here.

     User-level engines: engines that live only in a user's home (e.g. a
     scim-tables table under the user's data dir, or a licensed engine that
     cannot be installed system-wide) are not visible to the system generator.
     A user who has such engines runs the SAME command as themselves:

         scim -f ibus -- --xml > ~/.local/share/ibus/component/scim.xml

     and adds that directory to IBUS_COMPONENT_PATH BEFORE ibus-daemon starts
     (login shell or systemd user environment; ibus scans component dirs once
     at startup). IBUS_COMPONENT_PATH REPLACES ibus-daemon's default search
     path, and no per-user dir is scanned by default, so the system component
     directory must be listed too, e.g.

         export IBUS_COMPONENT_PATH="$HOME/.local/share/ibus/component:\
             $(pkg-config --variable=pkgdatadir ibus-1.0)/component"

     ibus-daemon UNIONs the engines from every manifest it scans (duplicate
     engine names: first loaded wins), so the personal file coexists with this
     system one -- the user's home-only engines simply add to the system set. -->

<component>
    <name>org.freedesktop.IBus.SCIM</name>
    <description>Smart Common Input Method</description>
    <exec>@bindir@/scim -f ibus -- --ibus</exec>
    <version>@VERSION@</version>
    <author>SCIM developers</author>
    <license>LGPL</license>
    <homepage>https://github.com/scim-im/scim</homepage>
    <textdomain>scim</textdomain>

    <engines>
        <engine>
            <name>scim</name>
            <language>other</language>
            <license>LGPL</license>
            <author>SCIM developers</author>
            <layout>us</layout>
            <longname>SCIM</longname>
            <description>Smart Common Input Method</description>
            <rank>1</rank>
        </engine>
    </engines>
</component>
